# Copia este archivo como .env.local y llena los valores.
# En Vercel, las mismas variables van en Settings > Environment Variables.

# ID de cliente web de Google (Google Cloud > Google Auth Platform > Clientes).
VITE_GOOGLE_CLIENT_ID=

# Supabase (Project Settings > API): URL del proyecto y llave pública (anon o publishable).
# Sin ellas, las portadas y los datos de los eventos nuevos quedan solo en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dominio de los portales: trusttix.xyz (landing), app., organizer. y staff.trusttix.xyz.
VITE_DOMINIO=trusttix.xyz

# Opcional: otra instancia del contrato TrustTix en Testnet.
# VITE_CONTRATO_ID=
